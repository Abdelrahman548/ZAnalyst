<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ZAnalyst.Desktop.Controls"
             xmlns:converters="using:ZAnalyst.Desktop.Converters"
             xmlns:vm="using:ZAnalyst.Desktop.ViewModels"
             xmlns:domain="using:ZAnalyst.Domain.Entities"
             xmlns:enums="using:ZAnalyst.Domain.Enums"
             xmlns:vlc="using:LibVLCSharp.Avalonia"
             x:Class="ZAnalyst.Desktop.Views.MatchAnalysisView"
             x:DataType="vm:MatchAnalysisViewModel">
    <UserControl.Resources>
        <converters:DrawingColorToBrushConverter x:Key="ButtonColorBrushConverter" />
        <Geometry x:Key="EditIconGeometry">M4 16.5V20H7.5L18.8 8.7L15.3 5.2L4 16.5ZM20.7 6.8C21.1 6.4 21.1 5.8 20.7 5.4L18.6 3.3C18.2 2.9 17.6 2.9 17.2 3.3L15.9 4.6L19.4 8.1L20.7 6.8Z</Geometry>
        <Geometry x:Key="NoteIconGeometry">M4 4H20V17H8L4 21V4ZM7 8H17M7 11H17M7 14H14</Geometry>
        <Geometry x:Key="DeleteIconGeometry">M5 6H19M9 6V4H15V6M18 6L17 20H7L6 6M10 10V16M14 10V16</Geometry>
        <Geometry x:Key="PlayerFilterIconGeometry">M12 12A4 4 0 1 0 12 4A4 4 0 0 0 12 12ZM4 21A8 8 0 0 1 20 21</Geometry>
        <Geometry x:Key="RateFilterIconGeometry">M4 5H20L14 12V19L10 21V12L4 5Z</Geometry>
        <Geometry x:Key="ActionFilterIconGeometry">M4 5H20M4 12H20M4 19H20M8 3V7M15 10V14M11 17V21</Geometry>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.action-icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style Selector="Button.edit-icon">
            <Setter Property="Foreground" Value="#55B8FF" />
        </Style>
        <Style Selector="Button.note-icon">
            <Setter Property="Foreground" Value="#B69CFF" />
        </Style>
        <Style Selector="Button.delete-icon">
            <Setter Property="Foreground" Value="#F07178" />
        </Style>
        <Style Selector="Button.mode-tab">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.mode-tab.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.player-chip">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Button.player-chip.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.rate-option">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style Selector="Button.rate-option.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.rate-filter">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
        </Style>
        <Style Selector="Button.rate-filter.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter-select">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style Selector="Border.analysis-entry">
            <Setter Property="Background" Value="#202A36" />
            <Setter Property="BorderBrush" Value="#526174" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Button Content="‹  Back" Command="{Binding BackCommand}"
                    IsEnabled="{Binding IsNotBusy}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding MatchTitle}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding SelectedPlayerLabel}" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}"
                    CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTimeText}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
            <Button Content="Events" Classes="mode-tab"
                    Classes.selected="{Binding IsEventsTab}"
                    Command="{Binding SelectEventsTabCommand}" />
            <Button Content="Actions" Classes="mode-tab"
                    Classes.selected="{Binding IsActionTab}"
                    Command="{Binding SelectActionsTabCommand}" />
        </StackPanel>

        <Border Grid.Row="2" Classes="surface-card" Padding="0">
            <Grid ColumnDefinitions="2.1*,1*" MinHeight="560">
                <Grid RowDefinitions="*,Auto,Auto" RowSpacing="12" Margin="16">
                    <Border Background="#0B0F14" CornerRadius="8" MinHeight="310">
                        <Grid RowDefinitions="*,Auto">
                            <Grid>
                                <vlc:VideoView x:Name="VideoView" IsVisible="{Binding IsVideoVisible}" />
                                <StackPanel IsVisible="{Binding !HasVideo}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="8" MaxWidth="390">
                                    <TextBlock Text="No video attached"
                                               FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Move through the timeline manually or attach a video when creating the match."
                                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                  ColumnSpacing="9" Margin="12,8">
                                <Button Content="‹ 5s" Click="BackFiveSeconds_Click" />
                                <Button Grid.Column="1" Content="+ 5s" Click="ForwardFiveSeconds_Click" />
                                <Button Grid.Column="2" Content="{Binding PlaybackButtonText}"
                                        Command="{Binding TogglePlaybackCommand}" IsEnabled="{Binding HasVideo}" />
                                <Slider Grid.Column="3" Minimum="0" Maximum="{Binding PlaybackDurationSeconds}"
                                        Value="{Binding PlaybackPositionSeconds, Mode=TwoWay}"
                                        IsEnabled="{Binding HasMatch}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="3">
                            <TextBlock Text="EVENT TIMELINE" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Press an event hotkey while watching, then use a marker to jump back."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentTimeText}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding EventTimelineLanes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MatchAnalysisViewModel+EventTimelineLaneViewModel">
                                    <Grid ColumnDefinitions="120,*" MinHeight="48"
                                          Margin="0,0,0,5">
                                    <Button Padding="0" Background="Transparent" BorderThickness="0"
                                            Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).RecordButtonCommand}"
                                            CommandParameter="{Binding Button}"
                                            IsEnabled="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).IsEventsTab}"
                                            VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="5,*" ColumnSpacing="7">
                                            <Border Background="{Binding Button.Color, Converter={StaticResource ButtonColorBrushConverter}}"
                                                    CornerRadius="2" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <Border IsVisible="{Binding HasHotkey}"
                                                        Background="{DynamicResource AppBackgroundBrush}"
                                                        CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding HotkeyLabel}" FontSize="9"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled">
                                        <Border Width="660" Height="36"
                                                Background="{DynamicResource AppBackgroundBrush}"
                                                CornerRadius="5">
                                            <Grid>
                                                <Border Height="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource BorderBrush}" />
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Width="660" Height="36" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerTheme>
                                                        <ControlTheme TargetType="ContentPresenter"
                                                                      x:DataType="vm:MatchAnalysisViewModel+AnalysisEntryViewModel">
                                                            <Setter Property="Canvas.Left"
                                                                    Value="{Binding TimelineLeft}" />
                                                            <Setter Property="Canvas.Top" Value="5" />
                                                        </ControlTheme>
                                                    </ItemsControl.ItemContainerTheme>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MatchAnalysisViewModel+AnalysisEntryViewModel">
                                                            <Button Width="{Binding TimelineWidth}" Height="26"
                                                                    Padding="0"
                                                                    Background="{Binding Button.Color, Converter={StaticResource ButtonColorBrushConverter}}"
                                                                    ToolTip.Tip="Click to jump; double-click to edit"
                                                                    Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).SeekToEntryCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    DoubleTapped="EditTimelineEntry_DoubleTapped" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0" Padding="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="surface-card" Padding="6,5"
                                IsVisible="{Binding IsActionTab}">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource PlayerFilterIconGeometry}" Width="16" Height="16"
                                          Foreground="#55B8FF" VerticalAlignment="Center" />
                                <ComboBox Classes="filter-select" Width="112"
                                          ItemsSource="{Binding PlayerFilterOptions}"
                                          SelectedItem="{Binding SelectedActionPlayerFilter, Mode=TwoWay}"
                                          ToolTip.Tip="Filter by player">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MatchAnalysisViewModel+PlayerFilterOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <PathIcon Data="{StaticResource RateFilterIconGeometry}" Width="16" Height="16"
                                          Foreground="#B69CFF" VerticalAlignment="Center" Margin="4,0,2,0" />
                                <Button Content="✓" Classes="rate-filter"
                                        Classes.selected="{Binding IsGoodRateFilterSelected}"
                                        Foreground="#38C981" ToolTip.Tip="Good actions only"
                                        Command="{Binding ToggleActionRateFilterCommand}"
                                        CommandParameter="{x:Static enums:ActionRate.Good}" />
                                <Button Content="•" Classes="rate-filter"
                                        Classes.selected="{Binding IsNaturalRateFilterSelected}"
                                        Foreground="#F3C653" ToolTip.Tip="Natural actions only"
                                        Command="{Binding ToggleActionRateFilterCommand}"
                                        CommandParameter="{x:Static enums:ActionRate.Natural}" />
                                <Button Content="×" Classes="rate-filter"
                                        Classes.selected="{Binding IsBadRateFilterSelected}"
                                        Foreground="#F07178" ToolTip.Tip="Bad actions only"
                                        Command="{Binding ToggleActionRateFilterCommand}"
                                        CommandParameter="{x:Static enums:ActionRate.Bad}" />
                                <PathIcon Data="{StaticResource ActionFilterIconGeometry}" Width="16" Height="16"
                                          Foreground="#55B8FF" VerticalAlignment="Center" Margin="4,0,2,0" />
                                <ComboBox Classes="filter-select" Width="112"
                                          ItemsSource="{Binding ButtonFilterOptions}"
                                          SelectedItem="{Binding SelectedActionButtonFilter, Mode=TwoWay}"
                                          ToolTip.Tip="Filter by action type">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MatchAnalysisViewModel+ButtonFilterOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Clear" Padding="6,3" Margin="3,0"
                                        ToolTip.Tip="Clear all action filters"
                                        IsVisible="{Binding HasActiveActionFilters}"
                                        Command="{Binding ClearActionFiltersCommand}" />
                            </WrapPanel>
                        </Border>
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10"
                          IsVisible="{Binding IsActionTab}">
                        <StackPanel Spacing="7">
                            <TextBlock Text="MY PLAYERS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding PlayerChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchAnalysisViewModel+PlayerChoiceViewModel">
                                        <Button Content="{Binding DisplayName}" Classes="player-chip"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).SelectPlayerCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Add players to this team before recording actions."
                                       IsVisible="{Binding !HasPlayers}" FontSize="11"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="ACTIONS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="Choose a player, then use a hotkey or button."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPlayerLabel}"
                                       FontSize="10" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>

                        <ScrollViewer Grid.Row="2" MaxHeight="130">
                            <ItemsControl ItemsSource="{Binding ActionButtons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="domain:Button">
                                        <Button Margin="0,0,6,6" Padding="0"
                                                IsEnabled="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).HasPlayers}"
                                                Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).RecordButtonCommand}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Border IsVisible="{Binding HasHotkey}"
                                                            Background="{DynamicResource SelectedSurfaceBrush}"
                                                            CornerRadius="3" Padding="4,2">
                                                        <TextBlock Text="{Binding HotKey}" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="3" IsVisible="{Binding HasPendingDoublePress}"
                                Background="{DynamicResource SelectedSurfaceBrush}"
                                CornerRadius="8" Padding="10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="#D94C4C" VerticalAlignment="Center">
                                    <TextBlock Text="●" FontSize="20" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="DOUBLE PRESS ARMED" FontSize="10"
                                               FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="{Binding PendingPressButtonName}" FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Press the same button again to set the end time."
                                               FontSize="10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="RECORDED ACTIONS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding FilteredActionCount}"
                                           FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding FilteredActionEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MatchAnalysisViewModel+AnalysisEntryViewModel">
                                                <Border Classes="analysis-entry" BorderThickness="1" CornerRadius="6"
                                                        Padding="5,4" Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                                        <Button Padding="3,0" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Background="Transparent" BorderThickness="0"
                                                                Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).SeekToEntryCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock Text="{Binding ButtonName}"
                                                                               FontSize="12" FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="#F4F7FB" />
                                                                    <TextBlock Text="{Binding PlayerLabel}"
                                                                               FontSize="11" FontWeight="Medium"
                                                                               Foreground="#B8C6D9" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding TimeRange}"
                                                                           FontSize="10" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#DCE6F2" />
                                                            </Grid>
                                                        </Button>
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding RateOptions}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:MatchAnalysisViewModel+ActionRateOptionViewModel">
                                                                    <Button ToolTip.Tip="{Binding ToolTip}"
                                                                            Classes="rate-option action-icon"
                                                                            Classes.selected="{Binding IsSelected}"
                                                                            Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).SetActionRateCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Text="{Binding Glyph}"
                                                                                   Foreground="{Binding IconBrush}"
                                                                                   FontSize="16" FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Grid.Column="2" ToolTip.Tip="Edit action details"
                                                                Classes="action-icon edit-icon"
                                                                Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).EditEntryCommand}"
                                                                CommandParameter="{Binding}">
                                                            <PathIcon Data="{StaticResource EditIconGeometry}" Width="15" Height="15"
                                                                      Foreground="#55B8FF" />
                                                        </Button>
                                                        <Button Grid.Column="3" ToolTip.Tip="Edit note"
                                                                Classes="action-icon note-icon"
                                                                Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).OpenNoteCommand}"
                                                                CommandParameter="{Binding}">
                                                            <PathIcon Data="{StaticResource NoteIconGeometry}" Width="15" Height="15"
                                                                      Foreground="#B69CFF" />
                                                        </Button>
                                                        <Button Grid.Column="4" ToolTip.Tip="Delete action"
                                                                Classes="action-icon delete-icon"
                                                                Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).DeleteEntryCommand}"
                                                                CommandParameter="{Binding}">
                                                            <PathIcon Data="{StaticResource DeleteIconGeometry}" Width="15" Height="15"
                                                                      Foreground="#F07178" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="Recorded actions will appear here."
                                           IsVisible="{Binding !HasActions}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="No actions match these filters."
                                           IsVisible="{Binding HasActions}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#B8C6D9" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="10"
                          IsVisible="{Binding IsEventsTab}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="EVENTS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="Use a hotkey or select an event to mark the current moment."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding EventEntries.Count}"
                                       FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="110">
                            <ItemsControl ItemsSource="{Binding EventButtons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="domain:Button">
                                        <Button Margin="0,0,6,6" Padding="0"
                                                Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).RecordButtonCommand}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                                    BorderBrush="{Binding Color, Converter={StaticResource ButtonColorBrushConverter}}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <Border IsVisible="{Binding HasHotkey}"
                                                            Background="{DynamicResource SelectedSurfaceBrush}"
                                                            CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding HotKey}" FontSize="9"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Grid.Row="2">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding EventEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MatchAnalysisViewModel+AnalysisEntryViewModel">
                                            <Border Classes="analysis-entry" BorderThickness="1" CornerRadius="6"
                                                    Padding="7" Margin="0,0,0,5">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                                    <Button HorizontalContentAlignment="Left"
                                                            Background="Transparent" BorderThickness="0"
                                                            Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).SeekToEntryCommand}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding ButtonName}" FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="#F4F7FB" />
                                                            <TextBlock Text="{Binding TimeRange}" FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#DCE6F2" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" ToolTip.Tip="Edit event"
                                                            Classes="action-icon edit-icon"
                                                            Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).EditEntryCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource EditIconGeometry}" Width="15" Height="15"
                                                                  Foreground="#55B8FF" />
                                                    </Button>
                                                    <Button Grid.Column="2" ToolTip.Tip="Delete event"
                                                            Classes="action-icon delete-icon"
                                                            Command="{Binding $parent[UserControl].((vm:MatchAnalysisViewModel)DataContext).DeleteEntryCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource DeleteIconGeometry}" Width="15" Height="15"
                                                                  Foreground="#F07178" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Select an event from the timeline or use its hotkey."
                                       IsVisible="{Binding !HasEvents}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" IsVisible="{Binding HasError}" Background="#3A2528"
                CornerRadius="7" Padding="10">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource ErrorBrush}" />
        </Border>

        <Grid Grid.RowSpan="4" IsVisible="{Binding IsAnyDialogOpen}" Background="#B8000000">
            <Border Width="520" MaxHeight="720" Padding="26" Classes="surface-card"
                    IsVisible="{Binding IsEditDialogOpen}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Edit analysis entry" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding EditingEntry.ButtonName}" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="START (HH:MM:SS.fff)" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox Text="{Binding EditStartTime}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="END (HH:MM:SS.fff)" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox Text="{Binding EditEndTime}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding EditingEntry.IsAction}">
                        <TextBlock Text="PLAYER" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding Players}" SelectedItem="{Binding EditPlayer}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:Player">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="RATE" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding ActionRates}" SelectedItem="{Binding EditRate}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="NOTE (OPTIONAL)" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox Text="{Binding EditNote}" AcceptsReturn="True" MinHeight="76"
                                 TextWrapping="Wrap" PlaceholderText="Add a note about this moment" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                               TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Button Content="Delete" Foreground="{DynamicResource ErrorBrush}"
                                Command="{Binding DeleteEntryCommand}"
                                CommandParameter="{Binding EditingEntry}" />
                        <Button Grid.Column="2" Content="Discard"
                                Command="{Binding DiscardEditCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <Button Grid.Column="3" Classes="primary-button" Content="Save"
                                Command="{Binding SaveEntryCommand}" IsEnabled="{Binding IsNotBusy}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Width="480" Padding="24" Classes="surface-card"
                    IsVisible="{Binding IsNoteDialogOpen}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Action note" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding NoteEntry.ButtonName}"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <TextBox Text="{Binding NoteText}" AcceptsReturn="True" MinHeight="110"
                             TextWrapping="Wrap" PlaceholderText="Add a note about this action" />
                    <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                               TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Discard" Command="{Binding DiscardNoteCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                        <Button Content="Save" Classes="primary-button" Command="{Binding SaveNoteCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
