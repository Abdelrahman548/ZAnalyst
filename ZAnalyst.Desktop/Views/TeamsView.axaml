<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZAnalyst.Desktop.ViewModels"
             xmlns:domain="using:ZAnalyst.Domain.Entities"
             x:Class="ZAnalyst.Desktop.Views.TeamsView"
             x:DataType="vm:TeamsViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
        <StackPanel HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <ComboBox Width="320" ItemsSource="{Binding Teams}"
                          SelectedItem="{Binding SelectedTeam, Mode=TwoWay}"
                          IsEnabled="{Binding IsNotBusy}"
                          PlaceholderText="Choose a team">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:Team">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Width="40" Height="40" Padding="9"
                        ToolTip.Tip="Add team"
                        Command="{Binding OpenCreateTeamCommand}"
                        IsEnabled="{Binding IsNotBusy}">
                    <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                </Button>
                <Button Width="40" Height="40" Padding="9"
                        ToolTip.Tip="Edit selected team"
                        Command="{Binding OpenEditTeamCommand}"
                        IsEnabled="{Binding HasSelectedTeam}">
                    <PathIcon Foreground="{DynamicResource SecondaryTextBrush}"
                              Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.04a1.003 1.003 0 0 0 0-1.42l-2.5-2.5a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 2-1.66z" />
                </Button>
                <Button Width="40" Height="40" Padding="9"
                        ToolTip.Tip="Delete selected team"
                        Command="{Binding DeleteTeamCommand}"
                        IsEnabled="{Binding HasSelectedTeam}">
                    <PathIcon Foreground="{DynamicResource ErrorBrush}"
                              Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Classes="surface-card" Padding="20">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding RosterTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage the players in the selected team."
                                   FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Players.Count}" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="PLAYERS" FontSize="9" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Button Width="36" Height="36" Padding="8"
                                ToolTip.Tip="Add player"
                                Command="{Binding OpenCreatePlayerCommand}"
                                IsEnabled="{Binding HasSelectedTeam}">
                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Text="{Binding PlayerSearchText}"
                             PlaceholderText="Search by player name or squad number"
                             IsEnabled="{Binding HasSelectedTeam}" />
                    <Button Grid.Column="1" Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding VisiblePlayers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="domain:Player">
                                    <Button Width="205" Height="82" Margin="0,0,10,10"
                                            Padding="0" Background="Transparent" BorderThickness="0"
                                            Command="{Binding $parent[UserControl].((vm:TeamsViewModel)DataContext).EditPlayerCommand}"
                                            CommandParameter="{Binding}">
                                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="9" Padding="12">
                                            <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
                                                <Border Width="38" Height="38" CornerRadius="10"
                                                        Background="{DynamicResource SelectedSurfaceBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Number}" FontSize="13"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Text="Click to edit" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel IsVisible="{Binding HasNoPlayers}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="7" MaxWidth="300">
                        <TextBlock Text="{Binding EmptyRosterMessage}" FontSize="14" FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Add a player to start building this team's roster."
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasNoMatchingPlayers}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="7" MaxWidth="300">
                        <TextBlock Text="No players found" FontSize="14" FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Try a different name or squad number."
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                                 Height="3" VerticalAlignment="Top" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" IsVisible="{Binding HasError}"
                Background="#3A2225" BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                       Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.RowSpan="3" IsVisible="{Binding HasToast}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="20" Padding="16,12" MaxWidth="420"
                CornerRadius="10" BorderThickness="1"
                BorderBrush="{DynamicResource ErrorBrush}" Background="#3A2225">
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding ToastTitle}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding ToastMessage}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.RowSpan="3" IsVisible="{Binding IsAnyDialogOpen}"
              Background="#B8000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Width="440" MaxHeight="560" Padding="24"
                    Classes="surface-card" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <StackPanel Spacing="16" IsVisible="{Binding IsTeamEditorVisible}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding TeamDialogTitle}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Manage the team name."
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBox Text="{Binding NewTeamName}" PlaceholderText="Team name"
                                 IsEnabled="{Binding IsNotBusy}"
                                 IsVisible="{Binding IsCreatingTeamDialog}" />
                        <TextBox Text="{Binding EditTeamName}" PlaceholderText="Team name"
                                 IsEnabled="{Binding IsNotBusy}"
                                 IsVisible="{Binding IsEditingTeamDialog}" />
                        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Discard" Command="{Binding DiscardTeamDialogCommand}" />
                            <Button Classes="primary-button" Content="Save"
                                    Command="{Binding SaveTeamDialogCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16" IsVisible="{Binding IsDeleteTeamConfirmationOpen}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Delete team?" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding SelectedTeam.Name}" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Teams with players or matches cannot be deleted."
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Command="{Binding CancelTeamDeleteCommand}" />
                            <Button Content="Delete" Foreground="{DynamicResource ErrorBrush}"
                                    Command="{Binding ConfirmDeleteTeamCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsPlayerEditorVisible}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding PlayerDialogTitle}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding SelectedTeam.Name}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBox Text="{Binding NewPlayerName}" PlaceholderText="Player name"
                                 IsEnabled="{Binding IsNotBusy}"
                                 IsVisible="{Binding IsCreatingPlayerDialog}" />
                        <TextBox Text="{Binding NewPlayerNumber}" PlaceholderText="Squad number"
                                 IsEnabled="{Binding IsNotBusy}"
                                 IsVisible="{Binding IsCreatingPlayerDialog}" />
                        <TextBox Text="{Binding EditPlayerName}" PlaceholderText="Player name"
                                 IsEnabled="{Binding IsNotBusy}"
                                 IsVisible="{Binding IsEditingPlayerDialog}" />
                        <TextBox Text="{Binding EditPlayerNumber}" PlaceholderText="Squad number"
                                 IsEnabled="{Binding IsNotBusy}"
                                 IsVisible="{Binding IsEditingPlayerDialog}" />
                        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Discard" Command="{Binding DiscardPlayerDialogCommand}" />
                            <Button Content="Delete" Foreground="{DynamicResource ErrorBrush}"
                                    Command="{Binding DeletePlayerCommand}"
                                    IsVisible="{Binding IsEditingPlayerDialog}" />
                            <Button Classes="primary-button" Content="Save"
                                    Command="{Binding SavePlayerDialogCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16" IsVisible="{Binding IsDeletePlayerConfirmationOpen}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Delete player?" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding SelectedPlayer.Name}" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="A player with recorded actions cannot be deleted."
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Command="{Binding CancelPlayerDeleteCommand}" />
                            <Button Content="Delete" Foreground="{DynamicResource ErrorBrush}"
                                    Command="{Binding ConfirmDeletePlayerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
