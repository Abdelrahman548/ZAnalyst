<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ZAnalyst.Desktop.Controls"
             xmlns:vm="using:ZAnalyst.Desktop.ViewModels"
             xmlns:domain="using:ZAnalyst.Domain.Entities"
             x:Class="ZAnalyst.Desktop.Views.TeamsView"
             x:DataType="vm:TeamsViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto">
            <controls:PageHeading Title="{Binding Title}" Description="{Binding Description}" />
            <Button Grid.Column="1" Content="Refresh"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="16">
            <Border Classes="surface-card" Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="5">
                            <TextBlock Text="YOUR TEAMS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Create and manage your squads"
                                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Teams.Count}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding NewTeamName}" PlaceholderText="New team name"
                                 IsEnabled="{Binding IsNotBusy}" />
                        <Button Grid.Column="1" Classes="primary-button" Content="Add"
                                Command="{Binding CreateTeamCommand}" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6"
                          IsVisible="{Binding HasSelectedTeam}">
                        <TextBox Text="{Binding EditTeamName}" PlaceholderText="Team name"
                                 IsEnabled="{Binding IsNotBusy}" />
                        <Button Grid.Column="1" Content="Save"
                                Command="{Binding UpdateTeamCommand}" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <ListBox ItemsSource="{Binding Teams}"
                                 SelectedItem="{Binding SelectedTeam, Mode=TwoWay}"
                                 IsEnabled="{Binding IsNotBusy}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:Team">
                                    <Border Padding="12,11" Margin="0,0,0,6"
                                            Background="Transparent"
                                            CornerRadius="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="2" VerticalAlignment="Center">
                                                <Button Width="30" Height="30" Padding="6"
                                                        Background="Transparent" BorderThickness="0"
                                                        CornerRadius="6" ToolTip.Tip="Edit team"
                                                        Command="{Binding $parent[UserControl].((vm:TeamsViewModel)DataContext).EditTeamCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Width="16" Height="16"
                                                              Foreground="{DynamicResource SecondaryTextBrush}"
                                                              Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.04a1.003 1.003 0 0 0 0-1.42l-2.5-2.5a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 2-1.66z" />
                                                </Button>
                                                <Button Width="30" Height="30" Padding="6"
                                                        Background="Transparent" BorderThickness="0"
                                                        CornerRadius="6" ToolTip.Tip="Delete team"
                                                        Command="{Binding $parent[UserControl].((vm:TeamsViewModel)DataContext).DeleteTeamCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Width="16" Height="16"
                                                              Foreground="{DynamicResource ErrorBrush}"
                                                              Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel IsVisible="{Binding HasNoTeams}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="7" MaxWidth="220">
                            <TextBlock Text="No teams yet" FontSize="14" FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Add a team to start building its player roster."
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="surface-card" Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding RosterTitle}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Select a player to edit or delete their profile"
                                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Players.Count}" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="PLAYERS" FontSize="9" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,100,Auto" ColumnSpacing="8"
                          IsVisible="{Binding HasNoSelectedPlayer}">
                        <TextBox Text="{Binding NewPlayerName}" PlaceholderText="Player name"
                                 IsEnabled="{Binding HasSelectedTeam}" />
                        <TextBox Grid.Column="1" Text="{Binding NewPlayerNumber}" PlaceholderText="Number"
                                 IsEnabled="{Binding HasSelectedTeam}" />
                        <Button Grid.Column="2" Classes="primary-button" Content="Add player"
                                Command="{Binding CreatePlayerCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,100,Auto,Auto" ColumnSpacing="6"
                          IsVisible="{Binding HasSelectedPlayer}">
                        <TextBox Text="{Binding EditPlayerName}" PlaceholderText="Player name"
                                 IsEnabled="{Binding IsNotBusy}" />
                        <TextBox Grid.Column="1" Text="{Binding EditPlayerNumber}" PlaceholderText="Number"
                                 IsEnabled="{Binding IsNotBusy}" />
                        <Button Grid.Column="2" Content="Save"
                                Command="{Binding UpdatePlayerCommand}" />
                        <Button Grid.Column="3" Content="Cancel"
                                Command="{Binding CancelPlayerEditCommand}" />
                    </Grid>

                    <TextBox Grid.Row="2" Text="{Binding PlayerSearchText}"
                             PlaceholderText="Filter by player name or number"
                             IsEnabled="{Binding HasSelectedTeam}" />

                    <ProgressBar Grid.Row="3" IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}" Height="3" />

                    <Grid Grid.Row="4">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="42,*,70" Margin="8,0,8,4">
                                <TextBlock Text="NO." FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="PLAYER" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Column="2" Text="ACTIONS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding VisiblePlayers}"
                                     SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="domain:Player">
                                        <Border Padding="10,9" Margin="0,0,0,5"
                                                Background="Transparent"
                                                CornerRadius="8">
                                            <Grid ColumnDefinitions="42,*,70">
                                                <Border Width="32" Height="32" CornerRadius="9"
                                                        Background="{DynamicResource SelectedSurfaceBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Number}" FontSize="12"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Width="30" Height="30" Padding="6"
                                                            Background="Transparent" BorderThickness="0"
                                                            CornerRadius="6"
                                                            ToolTip.Tip="Edit player"
                                                            Command="{Binding $parent[UserControl].((vm:TeamsViewModel)DataContext).EditPlayerCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Width="16" Height="16"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                                                  Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.04a1.003 1.003 0 0 0 0-1.42l-2.5-2.5a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 2-1.66z" />
                                                    </Button>
                                                    <Button Width="30" Height="30" Padding="6"
                                                            Background="Transparent" BorderThickness="0"
                                                            CornerRadius="6"
                                                            ToolTip.Tip="Delete player"
                                                            Command="{Binding $parent[UserControl].((vm:TeamsViewModel)DataContext).DeletePlayerCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Width="16" Height="16"
                                                                  Foreground="{DynamicResource ErrorBrush}"
                                                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" IsVisible="{Binding HasNoPlayers}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="7" MaxWidth="280">
                                <TextBlock Text="{Binding EmptyRosterMessage}" FontSize="14"
                                           FontWeight="SemiBold" TextAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="Add a player above using their squad number."
                                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" IsVisible="{Binding HasNoMatchingPlayers}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="7" MaxWidth="280">
                                <TextBlock Text="No players found" FontSize="14"
                                           FontWeight="SemiBold" TextAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="Try a different name or squad number."
                                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" IsVisible="{Binding HasError}"
                Background="#3A2225" BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                       Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.RowSpan="3" IsVisible="{Binding HasToast}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="20" Padding="16,12" MaxWidth="420"
                CornerRadius="10" BorderThickness="1"
                BorderBrush="{DynamicResource ErrorBrush}" Background="#3A2225">
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding ToastTitle}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding ToastMessage}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
