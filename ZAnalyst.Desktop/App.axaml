<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZAnalyst.Desktop.ViewModels"
             xmlns:views="using:ZAnalyst.Desktop.Views"
             x:Class="ZAnalyst.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ZAnalyst.Desktop/Styles/Controls.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ZAnalyst.Desktop/Resources/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:MatchesViewModel}">
            <views:MatchesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatchAnalysisViewModel}">
            <views:MatchAnalysisView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TeamsViewModel}">
            <views:TeamsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplatesViewModel}">
            <views:TemplatesView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>