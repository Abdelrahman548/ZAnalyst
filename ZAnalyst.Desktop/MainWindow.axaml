<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZAnalyst.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="ZAnalyst.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="ZAnalyst | Football Analysis"
        MinWidth="1060"
        MinHeight="680"
        Width="1440"
        Height="900">
    <Grid ColumnDefinitions="238,*"
          RowDefinitions="*">
        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="24">
                <StackPanel Orientation="Horizontal" Spacing="11" Margin="4,6,4,0">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="Z" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource AppBackgroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="ZAnalyst" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="FOOTBALL ANALYSIS" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="8" Padding="11,9">
                    <Grid ColumnDefinitions="Auto,*">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="LOCAL WORKSPACE" Margin="9,0,0,0"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="WORKSPACE" Margin="8,0,0,8"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <Button Classes="nav-button"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding}"
                                        Margin="0,1">
                                    <Grid ColumnDefinitions="34,*,Auto">
                                        <Border Width="28" Height="28" CornerRadius="7"
                                                Background="{DynamicResource HoverSurfaceBrush}">
                                            <TextBlock Text="{Binding Shortcut}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="4,16,4,2">
                    <StackPanel Spacing="5">
                        <TextBlock Text="PROTOTYPE BUILD" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="Local analysis workspace"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="76,*">
            <Border Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding CurrentDescription}" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="11,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="PROTOTYPE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="28,24" />
        </Grid>
    </Grid>
</Window>
